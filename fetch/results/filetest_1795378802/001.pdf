 .hs,.hs *{font-family:-apple-system,system-ui,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol";box-sizing:border-box}
.hs{display:flex;gap:16px;margin:14px 0;align-items:flex-start}
.hs-card{flex:1 1 0;min-width:0;background:#fff;border:1px solid #e8ecf1;border-radius:12px;padding:15px 17px;box-shadow:0 1px 3px rgba(20,40,80,.06)}
.hs-title{display:flex;align-items:center;gap:7px;font-size:19px;font-weight:700;color:#fff;line-height:1.3;margin:0 0 10px;background:#17182b;padding:9px 12px;border-radius:8px}
.hs-live{display:inline-flex;align-items:center;background:#e01e1e;color:#fff;font-size:11px;font-weight:800;letter-spacing:.04em;padding:3px 7px;border-radius:4px}
.hs-row{display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid #f1f3f6}
.hs-row:last-child{border-bottom:0}
.hs-pill{flex:0 0 auto;background:#e01e1e;color:#fff;font-size:10.5px;font-weight:800;letter-spacing:.03em;padding:5px 8px;border-radius:4px;white-space:nowrap;text-align:center}
.hs-name{flex:1 1 auto;min-width:0;font-size:14.5px;color:#1f2937;line-height:1.35;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hs-list{list-style:none;margin:0;padding:0}
.hs-list li{position:relative;padding:8px 0 8px 16px;font-size:14.5px;color:#1f2937;line-height:1.4}
.hs-list li:before{content:"";position:absolute;left:0;top:14px;width:6px;height:6px;border-radius:50%;background:#2563eb}
@media(prefers-reduced-motion:reduce){
.whatsapp-btn,.btn-title,.social-btn{transition:none!important}
.whatsapp-btn:hover,.join-sarkari-btn:hover,.social-btn:hover{transform:none!important}
.whatsapp-ico,.social-btn img,.social-btn svg{animation:none!important}
.wa-fa,.wa-fb,.sr-arw{animation:none!important}
.sr-arw,.join-sarkari-btn:hover .sr-arw{transform:none!important}
.wa-fa{opacity:1!important;clip-path:none!important}
.wa-fb{opacity:0!important}
}
@media(max-width:768px){
.hs{flex-direction:column;gap:12px}
.hs-card{width:100%}
.hs-title{font-size:17px}
.hs-name{font-size:13.5px}
.hs-list li{font-size:13.5px}
}
 

/* ===== Google "Add FreeJobAlert" card - from buttonstylenew.txt =====
   Replaces the old Google button markup in .games-buttons-row. Unlike the
   previous version this one loops (7s) and has no logo swap - the Google G
   stays put while the label and checkbox cycle. */
.fja-card {
    display: inline-block;
    width: 100%;
    max-width: 300px;
    contain: layout paint style;
}
.fja-card-link {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid #dcdcdc;
    border-radius: 12px;
    padding: 10px 14px;
    text-decoration: none;
}
.fja-icon { flex-shrink: 0; display: flex; align-items: center; }
.fja-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.fja-titlewrap { position: relative; height: 19px; }
.fja-subwrap { position: relative; height: 16px; }
.fja-t, .fja-sub {
    position: absolute;
    left: 0;
    top: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    will-change: opacity, transform;
}
.fja-t { font-size: 15px; font-weight: 600; color: #1a1a2e; }
.fja-sub { display: inline-flex; align-items: center; gap: 4px; font-size: 13px; color: #5f6368; }
.fja-badge svg { width: 13px; height: 13px; display: block; flex-shrink: 0; }

.fja-t1, .fja-sub1 { animation: fja-slide1 7s ease infinite; }
.fja-t2, .fja-sub2 { animation: fja-slide2 7s ease infinite; }

.fja-checkbox {
    position: relative;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    opacity: 0;
    animation: fja-cb-wrap 7s ease infinite;
    will-change: opacity;
}
.fja-cb-inner {
    width: 20px;
    height: 20px;
    display: block;
    transform-origin: center;
    animation: fja-cb-press 7s ease infinite;
    will-change: transform;
}
.fja-cb-check {
    fill: none;
    stroke: #1a73e8;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 20;
    stroke-dashoffset: 20;
    animation: fja-cb-check 7s ease infinite;
    will-change: stroke-dashoffset;
}

@keyframes fja-slide1 {
    0%, 26%  { opacity: 1; transform: translateY(0); }
    34%      { opacity: 0; transform: translateY(-4px); }
    82%      { opacity: 0; transform: translateY(-4px); }
    90%, 100% { opacity: 1; transform: translateY(0); }
}
@keyframes fja-slide2 {
    0%, 26%  { opacity: 0; transform: translateY(4px); }
    34%      { opacity: 1; transform: translateY(0); }
    82%      { opacity: 1; transform: translateY(0); }
    90%, 100% { opacity: 0; transform: translateY(4px); }
}
@keyframes fja-cb-wrap {
    0%, 26%  { opacity: 0; }
    34%      { opacity: 1; }
    84%      { opacity: 1; }
    90%, 100% { opacity: 0; }
}
/* The box fades in at 34%; ticking at 58% left a ~1.7s dead beat, which is
   what read as slow. Press and draw now start right after it appears. */
@keyframes fja-cb-press {
    0%, 40%   { transform: scale(1); }
    42%       { transform: scale(0.85); }
    45%       { transform: scale(1.1); }
    49%, 100% { transform: scale(1); }
}
@keyframes fja-cb-check {
    0%, 40%  { stroke-dashoffset: 20; }
    45%      { stroke-dashoffset: 0; }
    84%      { stroke-dashoffset: 0; }
    92%      { stroke-dashoffset: 20; }
    100%     { stroke-dashoffset: 20; }
}

@media (max-width: 380px) {
    .fja-card-link { padding: 8px 10px; gap: 8px; }
    .fja-t { font-size: 13px; }
    .fja-sub { font-size: 12px; }
}

@media (prefers-reduced-motion: reduce) {
    .fja-t1, .fja-sub1 { display: none; }
    .fja-t2, .fja-sub2, .fja-checkbox { opacity: 1; animation: none; }
    .fja-cb-inner, .fja-cb-check { animation: none; }
    .fja-cb-check { stroke-dashoffset: 0; }
}

/* ===== Upcoming Last Date Alerts banner ===== */
.ldra{max-width:620px;width:calc(100% - 10px);margin:20px auto;}
.ldra-link{display:flex;align-items:center;gap:10px;padding:13px 16px;background:#fff6ef;border:1px solid #ffe2d1;border-radius:12px;text-decoration:none;transition:background .15s ease,border-color .15s ease;}
.ldra-link:hover{background:#fff0e4;border-color:#ffd0b3;}
.ldra-dot{flex:0 0 auto;width:9px;height:9px;border-radius:50%;background:#ff3d00;animation:ldra-pulse 2s ease-in-out infinite;}
@keyframes ldra-pulse{0%,100%{opacity:1}50%{opacity:.4}}
.ldra-txt{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 8px;min-width:0;}
.ldra-title{font-size:17px;font-weight:700;color:#17182b;line-height:1.3;}
.ldra-count{font-size:15px;font-weight:700;color:#ff3d00;line-height:1.3;}
.ldra-btn{flex:0 0 auto;margin-left:auto;padding:9px 18px;background:#16172b;color:#fff;font-size:14px;font-weight:700;border-radius:999px;white-space:nowrap;transition:background .15s ease;}
.ldra-link:hover .ldra-btn{background:#2a2c48;}
@media(max-width:560px){
.ldra-link{gap:8px;padding:11px 13px;}
.ldra-txt{flex-direction:column;align-items:flex-start;gap:1px;}
.ldra-title{font-size:15px;}
.ldra-count{font-size:13px;}
.ldra-btn{padding:8px 14px;font-size:13px;}
}
@media(prefers-reduced-motion:reduce){.ldra-dot{animation:none;}}

/* ===== Free job alerts / register widget ===== */
.urw{width:fit-content;max-width:calc(100% - 10px);margin:16px auto 22px;}
.urw-row{display:flex;align-items:center;gap:16px;padding:13px 18px;background:#eef4ff;border:1px solid #d7e3fb;border-radius:12px;}
.urw-bell{position:relative;flex:0 0 auto;width:52px;height:52px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;}
.urw-bell svg{width:26px;height:26px;}
.urw-badge{position:absolute;top:2px;right:2px;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:#e01e1e;color:#fff;font-size:11px;font-weight:700;font-style:normal;line-height:17px;text-align:center;}
.urw-txt{display:flex;flex-direction:column;gap:3px;min-width:0;}
.urw-head{font-size:21px;font-weight:700;color:#111827;line-height:1.25;}
.urw-blue{color:#1554d4;font-weight:700;}
.urw-red{color:#e01e1e;font-weight:700;}
.urw-sub{font-size:14px;color:#6b7280;line-height:1.3;}
.urw-sep{flex:0 0 auto;width:1px;height:40px;background:#c9d9f5;}
.urw-btn{flex:0 0 auto;padding:12px 20px;background:#1554d4;color:#fff;font-size:15px;font-weight:700;border-radius:8px;text-decoration:none;white-space:nowrap;transition:background .15s ease;}
.urw-btn:hover{background:#1145b0;color:#fff;}
.urw-login{flex:0 0 auto;display:flex;align-items:center;gap:7px;color:#1554d4;font-size:15px;font-weight:600;text-decoration:none;white-space:nowrap;}
.urw-login svg{width:19px;height:19px;}
.urw-login:hover{color:#1145b0;text-decoration:underline;}
@media(max-width:900px){
.urw{width:auto;}
.urw-row{flex-wrap:wrap;gap:12px;justify-content:center;}
.urw-btn{flex:0 0 auto;text-align:center;}
.urw-head{font-size:18px;}
.urw-sep{display:none;}
.urw-txt{flex:1 1 200px;}
}
@media(max-width:560px){
.urw-row{padding:12px 13px;gap:10px;}
.urw-bell{width:42px;height:42px;}
.urw-bell svg{width:21px;height:21px;}
.urw-head{font-size:16px;}
.urw-sub{font-size:12.5px;}
.urw-btn{padding:10px 15px;font-size:14px;}
.urw-login{font-size:14px;}
}

/* Discussions search bar (replaces Google CSE box) */
  .fja-dq-search { display: flex; gap: 8px; margin: 14px 0 18px; }
  .fja-dq-search input { flex: 1; min-width: 0; border: 1px solid #d7dbe3; border-radius: 10px; padding: 11px 14px; font: inherit;
  font-size: 14px; background: #fff; }
  .fja-dq-search input:focus { outline: 2px solid #c7d2fe; border-color: #a5b4fc; }
  .fja-dq-search button { background: #4f46e5; color: #fff; border: 0; border-radius: 9px; padding: 9px 16px; font-weight: 700; font-size:
  13.5px; cursor: pointer; }
  .fja-dq-field { position: relative; flex: 1; min-width: 0; display: flex; }
  .fja-dq-ph { display: none; }
  @media (max-width: 600px) {
    .fja-dq-search { margin: 14px 18px 18px 8px; gap: 6px; }
    .fja-dq-search input { padding: 10px 12px; }
    .fja-dq-search input::placeholder { color: transparent; }
    .fja-dq-search button { flex: 0 0 auto; padding: 9px 14px; }
    .fja-dq-search input:placeholder-shown + .fja-dq-ph { display: block; position: absolute; left: 13px; right: 12px; top: 50%;
  transform: translateY(-50%); font-size: 14px; color: #757575; pointer-events: none; white-space: nowrap; overflow: hidden;
  text-overflow: ellipsis; text-align: left; }
  }
 </style>
