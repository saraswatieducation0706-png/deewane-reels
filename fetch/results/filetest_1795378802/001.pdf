    text-align: center;
    z-index: 10;
    transition: opacity 300ms ease-in-out;
}
a.generate-back-to-top {
    background-color: rgba(0, 0, 0, 0.4);
    color: #ffffff;
}
.generate-back-to-top {
    bottom: 102px;
}

.whatsapp-button-container {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}

.whatsapp-btn {
    background: #075E54;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 15px;
    text-decoration: none;
    padding: 8px 16px;
    min-height: 44px;
    border-radius: 12px;
    flex-shrink: 0;
    transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
    color: #fff !important;
    box-shadow: 0 1px 2px rgba(7,94,84,.20);
}
.whatsapp-btn:hover { background: #0a7264; }
.whatsapp-btn:focus-visible { outline: 2px solid #25D366; outline-offset: 2px; }
.whatsapp-btn:active { transform: none; box-shadow: 0 1px 2px rgba(7,94,84,.20); }
.wa-ico {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #25d366;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
/* Label flips between the two-line title and a single "Tap to Join", the same
   way the new card does. Both layers are absolutely positioned, so the wrapper
   needs an explicit height and min-width or the flex row would collapse it. */
.wa-txt { position: relative; display: block; height: 32px; min-width: 118px; line-height: 1.2; text-align: left; }
.wa-flip { position: absolute; left: 0; top: 0; width: 100%; }
.wa-fa { display: flex; flex-direction: column; animation: waFlipA 6s ease-in-out infinite; }
.wa-fb { display: flex; align-items: center; height: 32px; font-size: 16px; font-weight: 700; color: #fff; white-space: nowrap; animation: waFlipB 6s ease-in-out infinite; }
.wa-t1 { font-size: 15px; font-weight: 700; }
.wa-t2 { font-size: 11.5px; font-weight: 500; color: rgba(255,255,255,.85); }
.wa-arw { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px; background: #1faa54; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-size: 15px; line-height: 1; margin-left: 2px; }
@keyframes waFlipA {
    0%   { clip-path: inset(0 100% 0 0); opacity: 0; }
    12%  { clip-path: inset(0 0 0 0); opacity: 1; }
    45%  { clip-path: inset(0 0 0 0); opacity: 1; }
    50%, 100% { clip-path: inset(0 0 0 0); opacity: 0; }
}
@keyframes waFlipB {
    0%, 50% { clip-path: inset(0 100% 0 0); opacity: 0; }
    62%     { clip-path: inset(0 0 0 0); opacity: 1; }
    95%     { clip-path: inset(0 0 0 0); opacity: 1; }
    100%    { clip-path: inset(0 0 0 0); opacity: 0; }
}

.whatsapp-btn svg {
    margin-right: 0;
}

.whatsapp-ico {
    fill: #fff;
    width: 20px;
    height: 20px;
    background-color: transparent;
}

.join-play-games-btn {
    text-decoration: none;
}

.btn-text {
    display: flex;
    margin: 0;
}

.btn-title {
    background: #eef2fe;
    border: 1px solid #dbe3fb;
    color: #111827;
    font-size: 15px;
    font-weight: 700;
    padding: 8px 16px;
    min-height: 44px;
    border-radius: 12px;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
    transition: background .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    margin-right: 10px;
}
.join-sarkari-btn:hover .btn-title { background: #e6ecfd; border-color: #cfdcf9; }
.join-sarkari-btn:focus-visible { outline: 2px solid #1554d4; outline-offset: 2px; border-radius: 12px; }
.sr-ico { flex: 0 0 auto; width: 30px; height: 30px; border-radius: 50%; background: #1554d4; display: inline-flex; align-items: center; justify-content: center; }
.sr-ico svg { width: 17px; height: 17px; fill: #fff; display: block; }
.sr-arw { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px; background: #1554d4; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-size: 15px; line-height: 1; animation: srNudge 2.6s ease-in-out infinite; }
.join-sarkari-btn:hover .sr-arw { animation: none; transform: translateX(4px); transition: transform .18s ease; }
@keyframes srNudge {
    0%, 58% { transform: translateX(0); }
    68%     { transform: translateX(4px); }
    78%     { transform: translateX(0); }
    88%     { transform: translateX(4px); }
    100%    { transform: translateX(0); }
}

/* Google button styling */
.btn-title[style*="#4285F4"] {
    background-color: #4285F4 !important;
}


a .btn-title:hover {
    text-decoration: underline;
}

.games-buttons-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0.5em 0;
}

/* The Google card is width:100%/max-width:300px. As a bare flex item the
   container shrinks to fit its content (~258px), so the percentage never
   reaches 300px and the card renders narrower than designed. Giving the
   container the definite 300px lets the card size itself as authored. */
.join-google-container {
    flex: 0 0 300px;
    max-width: 300px;
}

.join-play-games-container,
.join-sarkari-container,
.join-mock-container {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}

.join-sarkari-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
}

.mobile-app {
    display: none;
}

.whatsapp-btn:hover,
.join-play-games-btn:hover,
.join-sarkari-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(16,24,40,.14);
}

@media (max-width: 767px) {
    .mobile-app {
        display: block;
    }

    .btn-title{
        margin-right: 0px;
    }

    .btn-text {
        display: flex;
        justify-content: center;
        align-items: center;
        /*margin-top: 0.5em;*/
    }

    .games-buttons-row {
        flex-direction: column;
        gap: 10px;
        width: 100%;
        display: none !important;
    }

    /* Hide Sarkari Result and Play Games buttons on mobile */
    .join-sarkari-container,
    .join-play-games-container,
    .join-google-container {
        display: none !important;
    }

    .whatsapp-button-container {
        width: 100%;
        max-width: 300px;
    }

    .btn-title {
        font-size: 16px;
        padding: 6px 10px;
    }

    /* Ensure search bar is visible on mobile */
    .gcse-searchbox-only {
        display: block !important;
        width: 100%;
    }

    /* Ensure whatsapp button is visible on mobile */
    .whatsapp-button-container {
        display: flex !important;
    }
}
.gb-grid-column-row1-col1,
.gb-grid-column-row1-col2,
.gb-grid-column-row1-col3,
.gb-grid-column-row2-col1,
.gb-grid-column-row2-col2,
.gb-grid-column-row2-col3,
